# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
VITE_MAPBOX_TOKEN=        # Mapbox access token for maps (legacy, unused now that Google Maps is integrated)
VITE_GOOGLE_MAPS_API_KEY= # Google Maps JavaScript API key (Maps JavaScript API, Places API, Directions API)

# ── Backend (Route Restrictions) ────────────────────────────────
GOOGLE_MAPS_SERVER_KEY=   # SEPARATE from VITE_GOOGLE_MAPS_API_KEY above — that one is browser-bundled
                           # and HTTP-referrer-restricted, so it can't authenticate server-to-server
                           # calls. Generate a fresh key in Google Cloud Console with the Directions
                           # API enabled, restricted by IP (or unrestricted in dev, never in prod).
                           # Used only by api/lib/googleDirectionsServer.ts for restriction-aware
                           # route avoidance — real per-call billing, same as any other Directions call.

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Backend (AI) ───────────────────────────────────────────────
GEMINI_API_KEY=           # Google Gemini API key (server-side only - never expose via VITE_ prefix)

# ── Backend (Push Notifications) ────────────────────────────────
FIREBASE_SERVICE_ACCOUNT= # Full Firebase service-account JSON as a single-line string
                           # (Firebase Console → Project Settings → Service Accounts →
                           # Generate new private key). Needed so notifications sent from
                           # the admin panel reach the wrapped native Android app's
                           # notification tray via FCM. Web push (regular browsers) works
                           # without this — it uses VAPID keys generated automatically.

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Backend (Razorpay) ───────────────────────────────────────────
RAZORPAY_KEY_ID=          # Razorpay Key ID (Dashboard → Settings → API Keys). Use rzp_test_ keys for
                           # development — School Ride subscription creation refuses to run against
                           # rzp_live_ keys (api/lib/razorpayClient.ts's assertSubscriptionAuthorizationAllowed).
RAZORPAY_KEY_SECRET=      # Razorpay Key Secret — server-side only, never expose via VITE_ prefix
RAZORPAY_WEBHOOK_SECRET=  # Dashboard → Settings → Webhooks → (your endpoint) → Secret. Verifies
                           # api/webhooks/razorpayWebhook.ts's inbound signature.

# ── Frontend (Razorpay — exposed to browser via Vite, KEY_ID only) ──
VITE_RAZORPAY_KEY_ID=     # Same value as RAZORPAY_KEY_ID above — Checkout needs it client-side to open

# ── Backend (Twilio Verify — real SMS OTP) ────────────────────────
TWILIO_ACCOUNT_SID=       # Twilio Console → Account SID
TWILIO_AUTH_TOKEN=        # Twilio Console → Auth Token — server-side only
TWILIO_VERIFY_SERVICE_SID= # Leave blank — created automatically on first OTP send and written back here
